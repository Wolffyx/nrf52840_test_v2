#include <zephyr/dt-bindings/led/led.h>

/ {
	chosen {
		zmk,kscan = &kscan;
		zmk,backlight = &backlight_pwm;
		zmk,underglow = &led_strip;
	};

	// Direct-pin kscan on the four onboard nrf52840-DK buttons.
	// Buttons are active-low (one side wired to GND, the other to the
	// SoC pin) so we use ACTIVE_LOW + an internal pull-up.
	//   BTN1 = P0.11   BTN2 = P0.12
	//   BTN3 = P0.24   BTN4 = P0.25
	// Position order in the keymap matches the input-gpios order below.
	kscan: kscan {
		compatible = "zmk,kscan-gpio-direct";
		input-gpios
			= <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpio0 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			;
	};

	// Backlight = onboard LED1 (P0.13) driven through PWM0 channel 0.
	// LED is active-low (anode tied to VDD), so polarity is inverted —
	// "0%" duty leaves it off, "100%" sinks current and lights it.
	backlight_pwm: backlight_pwm {
		compatible = "pwm-leds";
		bl_led_0: bl_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_INVERTED>;
		};
	};
};

// PWM0 → LED1 on P0.13. Override the board's default pwm0 pinctrl so
// channel 0 lands on the LED, leaving channels 1–3 unused.
&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>;
		};
	};
	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>;
			low-power-enable;
		};
	};

	// SPI3 MOSI → P1.13 (Arduino D11). MISO/SCK unused — WS2812 only
	// needs the data line.
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 1, 13)>;
		};
	};
	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 1, 13)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		// SPI bit clock — 4 MHz keeps the 0/1 frame timings within the
		// WS2812 spec (~1.25 µs per pixel bit).
		spi-max-frequency = <4000000>;
		// Adjust to match your strip length. The driver allocates a
		// per-LED buffer at boot so over-sizing wastes RAM.
		chain-length = <10>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
	};
};
