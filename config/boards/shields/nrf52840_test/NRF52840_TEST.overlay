#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/led/led.h>

/ {
	chosen {
		// ZMK Studio path: physical-layout owns the kscan + transform
		// references, so we don't list them as chosen here.
		zmk,physical-layout = &physical_layout_default;
		zmk,backlight = &backlight_pwm;
		zmk,underglow = &led_strip;
	};

	// Physical layout — 16 keys in two clusters:
	//   row 0    : 4 onboard buttons (4u wide bar at the top)
	//   rows 1-4 : 4×3 matrix below the buttons
	// Units are 1/100 of a key; 100×100 = a standard 1u keycap.
	physical_layout_default: physical_layout_default {
		compatible = "zmk,physical-layout";
		display-name = "DK Test";
		kscan = <&kscan>;
		transform = <&transform>;
		keys
			//                     w   h    x    y rot rx ry
			= <&key_physical_attrs 100 100    0    0   0  0  0>
			, <&key_physical_attrs 100 100  100    0   0  0  0>
			, <&key_physical_attrs 100 100  200    0   0  0  0>
			, <&key_physical_attrs 100 100  300    0   0  0  0>
			, <&key_physical_attrs 100 100    0  200   0  0  0>
			, <&key_physical_attrs 100 100  100  200   0  0  0>
			, <&key_physical_attrs 100 100  200  200   0  0  0>
			, <&key_physical_attrs 100 100    0  300   0  0  0>
			, <&key_physical_attrs 100 100  100  300   0  0  0>
			, <&key_physical_attrs 100 100  200  300   0  0  0>
			, <&key_physical_attrs 100 100    0  400   0  0  0>
			, <&key_physical_attrs 100 100  100  400   0  0  0>
			, <&key_physical_attrs 100 100  200  400   0  0  0>
			, <&key_physical_attrs 100 100    0  500   0  0  0>
			, <&key_physical_attrs 100 100  100  500   0  0  0>
			, <&key_physical_attrs 100 100  200  500   0  0  0>
			;
	};

	// Composite kscan stitches the 4 onboard buttons (direct kscan) and
	// a 4×3 matrix on the Arduino header into a single virtual 5×4 grid:
	//   row 0           = buttons (cols 0-3)
	//   rows 1..4       = matrix (cols 0-2)
	// The matrix_transform below flattens that grid into 16 keymap
	// positions: 0-3 = buttons, 4-15 = matrix in row-major order.
	kscan: kscan_composite {
		compatible = "zmk,kscan-composite";
		rows = <5>;
		columns = <4>;

		buttons {
			kscan = <&kscan_direct>;
			row-offset = <0>;
		};

		matrix {
			kscan = <&kscan_matrix>;
			row-offset = <1>;
		};
	};

	transform: transform {
		compatible = "zmk,matrix-transform";
		rows = <5>;
		columns = <4>;
		map = <
			RC(0,0) RC(0,1) RC(0,2) RC(0,3)
			RC(1,0) RC(1,1) RC(1,2)
			RC(2,0) RC(2,1) RC(2,2)
			RC(3,0) RC(3,1) RC(3,2)
			RC(4,0) RC(4,1) RC(4,2)
		>;
	};

	// Direct kscan on the four onboard nrf52840-DK buttons.
	// Buttons are active-low (one side wired to GND, the other to the
	// SoC pin) so we use ACTIVE_LOW + an internal pull-up.
	//   BTN1 = P0.11   BTN2 = P0.12
	//   BTN3 = P0.24   BTN4 = P0.25
	kscan_direct: kscan_direct {
		compatible = "zmk,kscan-gpio-direct";
		input-gpios
			= <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&gpio0 25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			;
	};

	// 4×3 matrix on Arduino-header pins. Wire each switch row→col with
	// a 1N4148 diode; cathode (band) toward the row pin (col2row).
	//   Rows: D2=P1.03, D3=P1.04, D4=P1.05, D5=P1.06
	//   Cols: D6=P1.07, D7=P1.08, D8=P1.10
	kscan_matrix: kscan_matrix {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";
		row-gpios
			= <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio1 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			;
		col-gpios
			= <&gpio1 7 GPIO_ACTIVE_HIGH>
			, <&gpio1 8 GPIO_ACTIVE_HIGH>
			, <&gpio1 10 GPIO_ACTIVE_HIGH>
			;
	};

	// Backlight = onboard LED1 (P0.13) driven through PWM0 channel 0.
	// LED is active-low (anode tied to VDD), so polarity is inverted —
	// "0%" duty leaves it off, "100%" sinks current and lights it.
	backlight_pwm: backlight_pwm {
		compatible = "pwm-leds";
		bl_led_0: bl_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_INVERTED>;
		};
	};
};

// PWM0 → LED1 on P0.13. Override the board's default pwm0 pinctrl so
// channel 0 lands on the LED, leaving channels 1–3 unused.
&pinctrl {
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>;
		};
	};
	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>;
			low-power-enable;
		};
	};

	// SPI3 MOSI → P1.13 (Arduino D11). MISO/SCK unused — WS2812 only
	// needs the data line.
	spi3_default: spi3_default {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 1, 13)>;
		};
	};
	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_MOSI, 1, 13)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi3 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		// SPI bit clock — 4 MHz keeps the 0/1 frame timings within the
		// WS2812 spec (~1.25 µs per pixel bit).
		spi-max-frequency = <4000000>;
		// Adjust to match your strip length. The driver allocates a
		// per-LED buffer at boot so over-sizing wastes RAM.
		chain-length = <10>;
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
	};
};
