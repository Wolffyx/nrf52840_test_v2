#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

// 4 onboard buttons. Position order = input-gpios order in the overlay:
//   pos0 = BTN1 (P0.11)
//   pos1 = BTN2 (P0.12)
//   pos2 = BTN3 (P0.24)
//   pos3 = BTN4 (P0.25)
//
// BTN4 always advances to the next layer. BTN1-3 carry the actual
// behaviors under test for that layer. After L8 it wraps back to L0.
//
// To peek at L2's "layer" behaviors (mo/tog/sl) you cycle to L2 first
// — when you tap mo/tog/sl while ON L2 they affect L7 ("destination"
// layer) so you can verify the behavior actually warps state.

/ {
    keymap {
        compatible = "zmk,keymap";

        // ─── L0 basic key-press ───
        // BTN1 A   BTN2 B   BTN3 C   BTN4 →L1
        l0_basic {
            bindings = <&kp A &kp B &kp C &to 1>;
        };

        // ─── L1 hold-tap + sticky-key ───
        // BTN1 MT(SFT,A)   BTN2 LT(7,SPC)   BTN3 SK(SFT)   BTN4 →L2
        l1_holdtap {
            bindings = <&mt LSHFT A &lt 7 SPACE &sk LSHFT &to 2>;
        };

        // ─── L2 layer behaviors (target = L7 so you see something) ───
        // BTN1 MO(7)   BTN2 TOG(7)   BTN3 SL(7)   BTN4 →L3
        l2_layer {
            bindings = <&mo 7 &tog 7 &sl 7 &to 3>;
        };

        // ─── L3 key-toggle / caps-word / key-repeat ───
        // BTN1 KT(CAPS)   BTN2 CAPS_WORD   BTN3 KEY_REPEAT   BTN4 →L4
        l3_keys {
            bindings = <&kt CAPSLOCK &caps_word &key_repeat &to 4>;
        };

        // ─── L4 misc — gresc / trans / none ───
        // BTN1 GRESC   BTN2 TRANS   BTN3 NONE   BTN4 →L5
        // (TRANS falls through to L0's mapping = &kp B.)
        // (NONE = nothing, the test is "no HID report").
        l4_misc {
            bindings = <&gresc &trans &none &to 5>;
        };

        // ─── L5 bluetooth / output ───
        // BTN1 BT_NXT   BTN2 BT_CLR   BTN3 OUT_TOG   BTN4 →L6
        l5_bt_out {
            bindings = <&bt BT_NXT &bt BT_CLR &out OUT_TOG &to 6>;
        };

        // ─── L6 mouse — button / move / scroll ───
        // BTN1 MB1   BTN2 MMV_RIGHT   BTN3 MSC_DOWN   BTN4 →L7
        l6_mouse {
            bindings = <&mkp MB1 &mmv MOVE_RIGHT &msc SCRL_DOWN &to 7>;
        };

        // ─── L7 RGB / backlight / studio ───
        // BTN1 RGB_TOG   BTN2 BL_TOG   BTN3 STUDIO_UNLOCK   BTN4 →L8
        l7_rgb_bl {
            bindings = <&rgb_ug RGB_TOG &bl BL_TOG &studio_unlock &to 8>;
        };

        // ─── L8 system reset / bootloader / soft-off ───
        // BTN1 SYS_RESET   BTN2 BOOTLOADER   BTN3 SOFT_OFF   BTN4 →L0
        // SOFT_OFF powers down — press the DK RESET button to wake.
        l8_system {
            bindings = <&sys_reset &bootloader &soft_off &to 0>;
        };
    };
};
