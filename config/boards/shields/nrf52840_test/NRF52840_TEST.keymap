#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>

// Position layout (16 keys/layer):
//
//   pos 0  = BTN1 (onboard P0.11)
//   pos 1  = BTN2 (onboard P0.12)
//   pos 2  = BTN3 (onboard P0.24)
//   pos 3  = BTN4 (onboard P0.25) — always &to next-layer
//
//   pos 4  pos 5  pos 6      ← matrix row 0
//   pos 7  pos 8  pos 9      ← matrix row 1
//   pos 10 pos 11 pos 12     ← matrix row 2
//   pos 13 pos 14 pos 15     ← matrix row 3
//
// On L0 the matrix is a numpad. On every other layer the matrix is
// &trans, so it always types numbers regardless of which behavior layer
// the buttons selected. Edit any matrix slot to change.

#define NUMPAD &kp N1 &kp N2 &kp N3   \
               &kp N4 &kp N5 &kp N6   \
               &kp N7 &kp N8 &kp N9   \
               &kp N0 &kp DOT &kp ENTER

#define MATRIX_TRANS &trans &trans &trans   \
                     &trans &trans &trans   \
                     &trans &trans &trans   \
                     &trans &trans &trans

/ {
    keymap {
        compatible = "zmk,keymap";

        // ─── L0 basic key-press ───
        l0_basic {
            bindings = <
                &kp A &kp B &kp C &to 1
                NUMPAD
            >;
        };

        // ─── L1 hold-tap + sticky-key ───
        l1_holdtap {
            bindings = <
                &mt LSHFT A &lt 7 SPACE &sk LSHFT &to 2
                MATRIX_TRANS
            >;
        };

        // ─── L2 layer behaviors (target = L7) ───
        l2_layer {
            bindings = <
                &mo 7 &tog 7 &sl 7 &to 3
                MATRIX_TRANS
            >;
        };

        // ─── L3 key-toggle / caps-word / key-repeat ───
        l3_keys {
            bindings = <
                &kt CAPSLOCK &caps_word &key_repeat &to 4
                MATRIX_TRANS
            >;
        };

        // ─── L4 misc — gresc / ext_power / none ───
        // (&trans is implicitly tested everywhere via layer fall-through.)
        l4_misc {
            bindings = <
                &gresc &ext_power EP_TOG &none &to 5
                MATRIX_TRANS
            >;
        };

        // ─── L5 bluetooth / output ───
        l5_bt_out {
            bindings = <
                &bt BT_NXT &bt BT_CLR &out OUT_TOG &to 6
                MATRIX_TRANS
            >;
        };

        // ─── L6 mouse — button / move / scroll ───
        l6_mouse {
            bindings = <
                &mkp MB1 &mmv MOVE_RIGHT &msc SCRL_DOWN &to 7
                MATRIX_TRANS
            >;
        };

        // ─── L7 RGB / backlight / studio ───
        l7_rgb_bl {
            bindings = <
                &rgb_ug RGB_TOG &bl BL_TOG &studio_unlock &to 8
                MATRIX_TRANS
            >;
        };

        // ─── L8 system reset / bootloader / soft-off ───
        l8_system {
            bindings = <
                &sys_reset &bootloader &soft_off &to 0
                MATRIX_TRANS
            >;
        };
    };
};
